<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Tappiru</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
    <div class="app-wrapper">
        <header class="site-header">
            <div class="container header-container">
                <div class="logo-wrapper">
                    <span class="logo-icon">🎵</span>
                    <span class="logo-text">Tappiru</span>
                    <span class="logo-badge">BETA</span>
                </div>
                <nav class="main-nav">
                    <a href="/" class="nav-link">Главная</a>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Profile" asp-action="Profile" class="nav-link">@User.Identity.Name</a>
                        <form asp-controller="Registration" asp-action="Logout" method="post" style="display:inline;">
                            <button type="submit" class="nav-link" style="background:none; border:none; cursor:pointer;">Выйти</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Registration" asp-action="Register" class="nav-link">Регистрация</a>
                        <a asp-controller="Registration" asp-action="Login" class="nav-link">Вход</a>
                    }
                </nav>
            </div>
        </header>

        <main class="site-main">
            <div class="container main-container">
                @RenderBody()
            </div>
        </main>

        <footer class="site-footer">
            <div class="container footer-container">
                <div class="footer-copyright">
                    <p>© 2025 Tappiru. Все права защищены.</p>
                    <p class="music-credit">Музыка и ритм — наше всё.</p>
                </div>
            </div>
        </footer>
    </div>
</body>
</html>