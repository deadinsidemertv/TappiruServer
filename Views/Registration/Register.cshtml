@model TappiruServer.Models.RegisterViewModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="register-container">
    <div class="register-card">
        <h1>Создать аккаунт</h1>
        <p class="subtitle">Присоединяйся к Tappiru и соревнуйся</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form asp-controller="Registration" asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" class="form-control" placeholder="Игровой ник" autocomplete="username" />
                <span asp-validation-for="UserName" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="example@tappiru.com" autocomplete="email" />
                <span asp-validation-for="Email" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" type="password" placeholder="******" autocomplete="new-password" />
                <span asp-validation-for="Password" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="******" autocomplete="off" />
                <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
            </div>

            <button type="submit" class="register-btn">Зарегистрироваться</button>
        </form>

        <div class="login-link">
            Уже есть аккаунт? <a asp-controller="Registration" asp-action="Login">Войти</a>
        </div>
    </div>
</div>